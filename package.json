{
  "scripts": {
    "build:markdown": "esbuild frontend/vendor-markdown.js --bundle --minify --platform=browser --format=iife --outfile=static/js/vendor-markdown.bundle.js && esbuild frontend/vendor-markdown.css --bundle --minify --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --asset-names=markdown-assets/[name]-[hash] --outfile=static/css/vendor-markdown.bundle.css",
    "build": "npm run build:markdown"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "markdown-it-texmath": "^1.0.0"
  }
}
